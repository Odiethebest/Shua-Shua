# --- WebAssembly build outputs ---
# NOTE: web/public/shuashua.js (single-file, wasm embedded) is intentionally COMMITTED
# so Cloudflare Pages can build from the repo — its CI image has no Emscripten. Rebuild
# AND re-commit it after any engine (C++) change: `bash scripts/build-wasm.sh`.
*.wasm
*.wat
*.wasm.map

# --- Cover-fetch staging dir (created + swapped by scripts/fetch-covers.mjs) ---
/web/public/covers.new/

# --- Node / frontend ---
/web/node_modules/
/web/dist/
/web/build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Env / secrets (the cover-fetch key is passed inline; never commit a key) ---
.env
.env.local
.env.*.local

# --- Design reference (third-party screenshots; not repo content) ---
/images/

# --- macOS ---
.DS_Store

